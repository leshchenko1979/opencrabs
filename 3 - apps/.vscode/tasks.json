{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy Traefik",
      "type": "shell",
      "command": "./scripts/deploy-traefik.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run Diagnostics",
      "type": "shell",
      "command": "./scripts/diagnostics.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "SSH: Connect to VDS",
      "type": "shell",
      "command": "ssh",
      "args": [
        "-i",
        "${env:HOME}/.ssh/id_ed25519",
        "root@apps"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}