# Copy to .env.gatus on the VPN host (same directory as docker-compose.yml). Never commit .env.gatus.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=133526395

# external-endpoints heartbeat tokens (Gatus config uses ${VAR} substitution)
SENDER_HEARTBEAT_TOKEN=
BUSINESS_TINDER_HEARTBEAT_TOKEN=

# Required on first deploy-gatus-bridge.sh (same value written to /etc/gatus-bridge.env on VPN host).
# Re-deploys reuse the existing secret from /etc/gatus-bridge.env if this is empty.
GATUS_BRIDGE_SECRET=
