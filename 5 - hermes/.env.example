# Copy to 5 - hermes/.env on your Mac (never commit .env).
# Used by deploy-opencrabs-ops-profile.sh and render-opencrabs-ops-config.sh

# Required — @redevest_admin_tools_bot (Gatus / ops profile)
REDEVEST_ADMIN_BOT_TOKEN=

# Optional — tg-mcp bearer for ops MCP tools; if empty, read from hermes default config at deploy
TG_MCP_BEARER=

# Optional — override hermes SSH (defaults match ~/.ssh/config Host hermes)
# REMOTE_HOST_IP=132.243.213.9
# REMOTE_SSH_PORT=18718
# REMOTE_USER=root
# SSH_KEY=~/.ssh/id_ed25519
