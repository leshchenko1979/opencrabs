# Copy to 5 - hermes/.env on your Mac (never commit .env).
# Used by deploy-opencrabs.sh and render-opencrabs-ops-config.sh

# Required for ops bootstrap / --config token patch — @redevest_admin_tools_bot
REDEVEST_ADMIN_BOT_TOKEN=

# Optional — tg-mcp bearer; rendered into /etc/tg-mcp/mcp.json on Hermes (deploy-opencrabs.sh --tg-tools)
# If empty, read from existing mcp.json or legacy config.toml [mcp] on host at render time
TG_MCP_BEARER=

# Optional — override hermes SSH (defaults match ~/.ssh/config Host hermes)
# REMOTE_HOST_IP=132.243.213.9
# REMOTE_SSH_PORT=18718
# REMOTE_USER=root
# SSH_KEY=~/.ssh/id_ed25519
