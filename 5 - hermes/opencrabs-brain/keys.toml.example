# Ops keys are rendered from opencrabs-profiles/ops/keys.toml.template at deploy time.
# See 5 - hermes/.env.example (REDEVEST_ADMIN_BOT_TOKEN).
#
# Do NOT add [channels.telegram] to ~/.opencrabs/keys.toml (default profile).
# Default uses [telegram].bot_token only; ops token there breaks @oc_l1979_bot polling.

[channels.telegram]
token = "REPLACE_ME"

[providers.minimax]
api_key = "COPY_FROM_DEFAULT_PROFILE"

[providers.openrouter]
api_key = "COPY_FROM_DEFAULT_PROFILE"

[providers.gemini]
api_key = "COPY_FROM_DEFAULT_PROFILE"
